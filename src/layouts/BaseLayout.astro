---
import Nav from '../components/Nav.astro';
import '../styles/global.css';
import { getLang, getLocalePath, t } from '../i18n';

interface Props {
  title: string;
  description?: string;
  section?: 'pro' | 'hobby';
}

const { title, description = 'Michael Schempp — Software Architect & Pinball Nerd', section } = Astro.props;
const lang = getLang(Astro.url);
const tr = t(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title} — Michael Schempp</title>
    <meta property="og:title" content={`${title} — Michael Schempp`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'de_DE'} />
    <script is:inline>
      // Prevent flash of wrong theme
      const theme = localStorage.getItem('theme') ?? 'dark';
      if (theme === 'light') document.documentElement.classList.add('light');
    </script>
  </head>
  <body>
    <Nav section={section} />
    <main>
      <slot />
    </main>
    <footer class="mt-24 border-t border-[var(--color-border)] px-4 py-8 flex flex-col sm:flex-row items-center justify-center gap-y-1 text-center text-sm text-[var(--color-text-muted)] font-mono">
      <span>© {new Date().getFullYear()} Michael Schempp</span>
      <span class="mx-2 opacity-30 hidden sm:inline">·</span>
      <span>michaelschempp.de</span>
      <span class="mx-2 opacity-30 hidden sm:inline">·</span>
      <span>
        <a href={getLocalePath(lang, '/faq')} class="hover:text-[var(--color-text)] transition-colors">{tr.footer.faq}</a>
        <span class="mx-2 opacity-30">·</span>
        <a href={getLocalePath(lang, '/impressum')} class="hover:text-[var(--color-text)] transition-colors">{tr.footer.imprint}</a>
        <span class="mx-2 opacity-30">·</span>
        <a href={getLocalePath(lang, '/datenschutz')} class="hover:text-[var(--color-text)] transition-colors">{tr.footer.privacy}</a>
      </span>
    </footer>
    <script is:inline>
      // External links always open in a new tab
      for (const a of document.querySelectorAll('a[href^="http"]')) {
        if (a.host !== location.host) {
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
        }
      }
    </script>
  </body>
</html>
