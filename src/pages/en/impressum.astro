---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Legal Notice">
  <div class="mx-auto max-w-2xl px-6 py-16">
    <h1 class="font-mono text-2xl font-bold mb-8">Legal Notice</h1>

    <section class="mb-8">
      <h2 class="font-mono text-sm uppercase tracking-widest text-[var(--color-text-muted)] mb-3">Information pursuant to § 5 TMG</h2>
      <p class="leading-relaxed">
        Michael Schempp<br />
        Breitenfeldstr. 2<br />
        79341 Kenzingen<br />
        Germany
      </p>
    </section>

    <section class="mb-8">
      <h2 class="font-mono text-sm uppercase tracking-widest text-[var(--color-text-muted)] mb-3">Contact</h2>
      <p>
        Email: <a href="mailto:contact@michaelschempp.de" class="text-[var(--color-pro)] hover:underline">contact@michaelschempp.de</a>
      </p>
    </section>

    <section class="mb-8">
      <h2 class="font-mono text-sm uppercase tracking-widest text-[var(--color-text-muted)] mb-3">Liability for content</h2>
      <p class="leading-relaxed text-[var(--color-text-muted)]">
        As a service provider, I am responsible for my own content on these pages in accordance with § 7 (1) TMG and the general laws. Pursuant to §§ 8 to 10 TMG, however, I am not obliged as a service provider to monitor transmitted or stored third-party information or to investigate circumstances that indicate illegal activity.
      </p>
    </section>

    <p class="text-sm text-[var(--color-text-muted)]">
      This is a convenience translation. In case of doubt, the <a href="/impressum" class="text-[var(--color-pro)] hover:underline">German version</a> prevails.
    </p>
  </div>
</BaseLayout>
