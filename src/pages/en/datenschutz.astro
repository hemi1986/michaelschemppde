---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Privacy Policy">
  <div class="mx-auto max-w-2xl px-6 py-16">
    <h1 class="font-mono text-2xl font-bold mb-8">Privacy Policy</h1>

    <section class="mb-8">
      <h2 class="font-mono text-sm uppercase tracking-widest text-[var(--color-text-muted)] mb-3">Controller</h2>
      <p class="leading-relaxed">
        Michael Schempp<br />
        Breitenfeldstr. 2<br />
        79341 Kenzingen<br />
        Germany<br />
        Email: <a href="mailto:contact@michaelschempp.de" class="text-[var(--color-pro)] hover:underline">contact@michaelschempp.de</a>
      </p>
    </section>

    <section class="mb-8">
      <h2 class="font-mono text-sm uppercase tracking-widest text-[var(--color-text-muted)] mb-3">Hosting</h2>
      <p class="leading-relaxed text-[var(--color-text-muted)]">
        This website is hosted by all-inkl.com (Neue Medien Münnich, owner René Münnich, Hauptstraße 68, 02742 Friedersdorf, Germany). When this website is accessed, the hosting provider automatically records server log files containing information such as IP address, browser type, operating system and time of access. This data is used exclusively for the technical provision of the website and to ensure its operation. The legal basis is Art. 6 (1) (f) GDPR (legitimate interest). Further information can be found in the <a href="https://all-inkl.com/datenschutzinformationen/" class="text-[var(--color-pro)] hover:underline" target="_blank" rel="noopener noreferrer">privacy policy of all-inkl.com</a>.
      </p>
    </section>

    <section class="mb-8">
      <h2 class="font-mono text-sm uppercase tracking-widest text-[var(--color-text-muted)] mb-3">Cookies and local storage</h2>
      <p class="leading-relaxed text-[var(--color-text-muted)]">
        This website does not use cookies. Only your browser's local storage (localStorage) is used to save your theme setting (light/dark). This data remains on your device and is not transmitted to any server.
      </p>
    </section>

    <section class="mb-8">
      <h2 class="font-mono text-sm uppercase tracking-widest text-[var(--color-text-muted)] mb-3">Analytics and tracking</h2>
      <p class="leading-relaxed text-[var(--color-text-muted)]">
        This website does not use any analytics or tracking tools. No user data is collected or processed for analytics or advertising purposes.
      </p>
    </section>

    <p class="text-sm text-[var(--color-text-muted)]">
      This is a convenience translation. In case of doubt, the <a href="/datenschutz" class="text-[var(--color-pro)] hover:underline">German version</a> prevails.
    </p>
  </div>
</BaseLayout>
