---
import BaseLayout from '@layouts/BaseLayout.astro';
import { t } from '@i18n';

const tr = t('en');
---

<BaseLayout title={`404 — ${tr.notFound.title}`}>
  <div class="max-w-2xl mx-auto px-6 py-32 text-center font-mono">
    <div class="text-8xl font-bold text-[var(--color-border)] mb-6">404</div>
    <h1 class="text-2xl font-bold mb-4">{tr.notFound.title}</h1>
    <p class="text-[var(--color-text-muted)] mb-12">{tr.notFound.text}</p>
    <a href="/en/" class="text-[var(--color-pro)] hover:underline">{tr.notFound.home}</a>
  </div>
</BaseLayout>
