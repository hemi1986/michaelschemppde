---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';

const de = t('de');
const en = t('en');
---

<BaseLayout title={`404 — ${de.notFound.title}`}>
  <div class="max-w-2xl mx-auto px-6 py-32 text-center font-mono">
    <div class="text-8xl font-bold text-[var(--color-border)] mb-6">404</div>
    <div data-404-lang="de">
      <h1 class="text-2xl font-bold mb-4">{de.notFound.title}</h1>
      <p class="text-[var(--color-text-muted)] mb-12">{de.notFound.text}</p>
      <a href="/" class="text-[var(--color-pro)] hover:underline">{de.notFound.home}</a>
    </div>
    <div data-404-lang="en" lang="en" hidden>
      <h1 class="text-2xl font-bold mb-4">{en.notFound.title}</h1>
      <p class="text-[var(--color-text-muted)] mb-12">{en.notFound.text}</p>
      <a href="/en/" class="text-[var(--color-pro)] hover:underline">{en.notFound.home}</a>
    </div>
  </div>
  <script is:inline define:vars={{ enTitle: `404 — ${en.notFound.title} — Michael Schempp` }}>
    // The server delivers this one file for every unknown URL, so pick the language from the requested path
    if (/^\/en(\/|$)/.test(location.pathname)) {
      document.querySelector('[data-404-lang="de"]').hidden = true;
      document.querySelector('[data-404-lang="en"]').hidden = false;
      document.title = enTitle;
    }
  </script>
</BaseLayout>
